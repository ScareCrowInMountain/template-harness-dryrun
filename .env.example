# Copy to .env for local dev. Never commit .env. Every variable used by the app
# MUST be listed here (src/lib/env.ts validates them at startup).

# --- Supabase (local: `supabase start` prints these) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
# Server-only. Never ship to a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
